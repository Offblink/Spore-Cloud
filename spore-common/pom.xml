<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.offblink</groupId>
    <artifactId>spore-cloud</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>spore-common</artifactId>
  <name>spore-common</name>
  <description>跨服务共享：R 包装、错误码、同步 DTO、网关注入身份的签名与过滤</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- 只在 servlet 服务（user/content）编译期用；gateway 是 WebFlux，不加载这些类 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- 统一异常处理器（@RestControllerAdvice + ResponseEntity）与日志 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
